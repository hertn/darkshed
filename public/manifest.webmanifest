{
  "name": "DarkShed",
  "short_name": "DarkShed",
  "description": "RAW and JPEG photo editor that runs in your browser",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141211",
  "theme_color": "#141211",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "image/*": [".jpg", ".jpeg", ".png", ".heic", ".dng", ".raf", ".cr2", ".cr3", ".nef", ".arw", ".orf", ".rw2"] } }
  ]
}
